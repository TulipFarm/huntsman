---
import '@fontsource-variable/onest';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import { repo } from '../data/site';
import { stars } from '../data/github';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const links = [
  ['Agent setup', '/agents'],
  ['Benchmarks', '/#benchmarks'],
  ['API', '/#api'],
  ['Open source', '/#open-source'],
];
const menu = [...links, ['GitHub', repo], ['Install', '/install']];

const footerCols: [string, [string, string][]][] = [
  ['Huntsman', [['Agent setup', '/agents'], ['Install', '/install'], ['Benchmarks', '/#benchmarks'], ['Try it', '/#try']]],
  ['Reference', [['API', '/#api'], ['Configuration', '/#config'], ['install.md', '/install.md'], ['install.sh', '/install.sh']]],
  ['Open source', [['GitHub', repo], ['Contributing', `${repo}/blob/main/CONTRIBUTING.md`], ['Releases', `${repo}/releases`], ['Notices', `${repo}/blob/main/NOTICE`], ['TulipFarm', 'https://tulipfarm.ai']]],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#fefdfb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Huntsman home">
          <svg class="mark" aria-hidden="true" viewBox="0 0 32 32" width="28" height="28">
            <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 13 8 7 3 8M12.5 15.5 6 13l-4 3M13 18l-6 3-3 5M14.5 19.5 12 26l2 4"></path>
              <path d="M19 13l5-6 5 1M19.5 15.5 26 13l4 3M19 18l6 3 3 5M17.5 19.5 20 26l-2 4"></path>
            </g>
            <ellipse cx="16" cy="13.5" rx="3.4" ry="3" fill="currentColor"></ellipse>
            <ellipse cx="16" cy="20" rx="2.6" ry="3.6" fill="currentColor"></ellipse>
          </svg>
          <span>Huntsman</span>
        </a>
        <nav aria-label="Main">
          <ul class="links">
            {
              links.map(([label, href]) => (
                <li>
                  <a href={href} aria-current={href === path ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="actions">
          <a class="button secondary small soft gh" href={repo}>
            <Logo name="GitHub" size={16} />
            <span>GitHub</span>
            {stars && <span class="stars">{stars}</span>}
          </a>
          <a class="button primary small" href="/install">Install</a>
          <details class="menu">
            <summary aria-label="Menu">
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            </summary>
            <ul>
              {menu.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
            </ul>
          </details>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <img class="footer-art" src="/art/footer.webp" alt="" width="1536" height="1024" loading="lazy" decoding="async" />
      <div class="wrap footer-card">
        <div class="footer-cols">
          {
            footerCols.map(([title, items]) => (
              <div>
                <h2 class="footer-title">{title}</h2>
                <ul>
                  {items.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="footer-base">
          <a class="brand" href="/" aria-label="Huntsman home">
            <svg class="mark" aria-hidden="true" viewBox="0 0 32 32" width="32" height="32">
              <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 13 8 7 3 8M12.5 15.5 6 13l-4 3M13 18l-6 3-3 5M14.5 19.5 12 26l2 4"></path>
                <path d="M19 13l5-6 5 1M19.5 15.5 26 13l4 3M19 18l6 3 3 5M17.5 19.5 20 26l-2 4"></path>
              </g>
              <ellipse cx="16" cy="13.5" rx="3.4" ry="3" fill="currentColor"></ellipse>
              <ellipse cx="16" cy="20" rx="2.6" ry="3.6" fill="currentColor"></ellipse>
            </svg>
            <span>Huntsman</span>
          </a>
          <p class="license">
            Apache-2.0. The install script and Docker image also ship Lightpanda (AGPL-3.0, run unmodified as a
            separate process) and the EasyList filter lists.
          </p>
          <p>Built by <a href="https://tulipfarm.ai">TulipFarm</a>.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-block: var(--space-3);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 60px;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(12px);
    box-shadow: 0 6px 24px -12px rgb(27 26 24 / 0.18);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h);
    color: var(--text);
    text-decoration: none;
    font-weight: 620;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }

  .mark {
    color: var(--accent);
  }

  nav {
    margin-right: auto;
  }

  .links,
  .menu ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 480;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  nav a[aria-current='page'] {
    background: var(--surface-2);
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover,
    .menu a:hover {
      background: var(--surface-2);
      text-decoration: none;
    }
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .button.soft {
    border-color: transparent;
    background: var(--surface-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .button.soft:hover {
      background: var(--surface-3);
    }
  }

  .gh {
    gap: var(--space-2);
  }

  .stars {
    padding-left: var(--space-2);
    border-left: 1px solid var(--border-strong);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: var(--control-h);
    height: var(--control-h);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu[open] summary {
    background: var(--surface-3);
  }

  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-3));
    flex-direction: column;
    min-width: 13rem;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: 0 16px 40px -16px rgb(27 26 24 / 0.3);
    transform-origin: top right;
    animation: menu-in var(--dur-fast) var(--ease-out);
  }

  .menu ul a {
    display: flex;
    min-height: var(--control-h);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .site-footer {
    position: relative;
    margin-top: var(--space-24);
    padding-top: clamp(160px, 22vw, 340px);
    padding-bottom: var(--space-12);
    background: #87a647;
    overflow: hidden;
  }

  .footer-art {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .footer-card {
    position: relative;
    display: grid;
    gap: var(--space-12);
    padding: var(--space-12);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .footer-title {
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-cols ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-cols a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-cols a:hover {
      color: var(--text);
      text-decoration: underline;
    }
  }

  .footer-base {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .footer-base .brand {
    font-size: 1.375rem;
  }

  .license {
    max-width: 64ch;
  }

  .footer-base a:not(.brand) {
    color: var(--text);
  }

  @media (max-width: 960px) {
    .links,
    .actions .soft {
      display: none;
    }

    .menu {
      display: block;
    }

    .bar {
      justify-content: space-between;
    }
  }

  @media (max-width: 720px) {
    .footer-card {
      padding: var(--space-8) var(--space-6);
    }

    .footer-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-base {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }

  @media (max-width: 400px) {
    .actions .primary {
      display: none;
    }
  }
</style>
