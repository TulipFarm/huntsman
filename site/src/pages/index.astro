---
import Layout from '../layouts/Layout.astro';
import Benchmarks from '../components/Benchmarks.astro';
import CodeBlock from '../components/CodeBlock.astro';
import CopyField from '../components/CopyField.astro';
import Icon from '../components/Icon.astro';
import LiveScrape from '../components/LiveScrape.astro';
import Logo from '../components/Logo.astro';
import { brand } from '../data/logos';
import { highlight } from '../lib/syntax';
import { machines, ratio } from '../data/benchmarks';
import { agentPrompt, harnesses, install, mcpUrl, repo } from '../data/site';
import { latest, stars } from '../data/github';

const claude = `claude mcp add --transport http --scope user huntsman ${mcpUrl}`;

const serverOpen = `echo "HUNTSMAN_ADDR=0.0.0.0:8080" >> ~/.huntsman/env && echo "HUNTSMAN_TOKEN=$(openssl rand -hex 32)" >> ~/.huntsman/env && huntsman restart`;
const remoteClaude = `claude mcp add --transport http --scope user huntsman https://<your-server>/mcp --header "Authorization: Bearer <your-token>"`;

const ossLinks: ['code' | 'tag' | 'issue' | 'pull', string, string][] = [
  ['code', 'Read the source', repo],
  ['tag', 'Releases and changelog', `${repo}/releases`],
  ['issue', 'Report a bug or ask for a feature', `${repo}/issues`],
  ['pull', 'Contribute', `${repo}/blob/main/CONTRIBUTING.md`],
];

const scrape = `curl -s localhost:8080/v1/scrape \\
  -H 'Content-Type: application/json' \\
  -d '{"url": "https://example.com"}'`;

const response = `{
  "success": true,
  "data": {
    "markdown": "This domain is for use in documentation examples …",
    "links": ["https://iana.org/help/example-domains"],
    "metadata": {
      "title": "Example Domain",
      "statusCode": 200,
      "engine": "lightpanda"
    }
  }
}`;

const crawl = `curl -s localhost:8080/v1/crawl \\
  -H 'Content-Type: application/json' \\
  -d '{"url": "https://example.com", "limit": 50, "maxDepth": 2}'
# → {"success": true, "id": "…"}

curl -s 'localhost:8080/v1/crawl/<id>?offset=0'`;

const tools = [
  ['scrape', 'Read one page as Markdown, with its links'],
  ['batch_scrape', 'Start reading up to 1,000 pages at once'],
  ['crawl', 'Follow links across a site, up to a page limit and depth'],
  ['get_job', 'Progress and result of a batch_scrape page'],
  ['get_crawl', 'Progress and pages of a crawl'],
];

const endpoints = [
  ['POST', '/v1/scrape', 'Scrape one URL and return Markdown and links'],
  ['POST', '/v1/batch', 'Queue 1–1,000 URLs with shared scrape options'],
  ['GET', '/v1/jobs/{id}', 'Status and result of a queued job'],
  ['POST', '/v1/crawl', 'Crawl a site up to a page limit and depth'],
  ['GET', '/v1/crawl/{id}', 'Crawl progress and pages, paged with ?offset='],
  ['POST', '/mcp', 'MCP server with the same tools, for AI agents'],
  ['GET', '/health', 'Liveness and storage check'],
];

const settings = [
  ['HUNTSMAN_ADDR', '127.0.0.1:8080', 'Listen address. Only your machine can reach the default; Docker listens on 0.0.0.0:8080 inside the container.'],
  ['HUNTSMAN_WORKERS', '16 per CPU', 'Pages scraped at once, capped at one per 96 MB of memory. The install script sets 8.'],
  ['HUNTSMAN_PER_HOST', '2', 'Most pages scraped at once from a single site, so one site isn’t flooded. Max 64.'],
  ['HUNTSMAN_TOKEN', 'empty', 'Bearer token; empty turns auth off'],
  ['HUNTSMAN_CACHE_TTL', '1h', 'Default result cache age, up to 168h'],
  ['HUNTSMAN_OBEY_ROBOTS', 'true', 'Respect robots.txt'],
  ['HUNTSMAN_MCP', 'true', 'Serve the MCP endpoint at /mcp'],
];

// Real output for go.dev/blog/go1.22 (tokens counted with cl100k). The tracker URL is
// split out so it can be struck through where the blocklist catches it.
const htmlTokens = 7764;
const mdTokens = 1043;
const saved = Math.round((1 - mdTokens / htmlTokens) * 100);
const rawHead = `<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'`;
const rawTracker = 'https://www.googletagmanager.com/gtm.js';
const rawTail = `?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-W8MVQXG');</script>
<script src="/js/site.js"></script>
<meta name="og:url" content="https://go.dev/blog/go1.22">
<meta name="og:title" content="Go 1.22 is released! - The Go Programming Language">
<title>Go 1.22 is released! - The Go Programming Language</title>`;
const markdown = `# Go 1.22 is released!

Eli Bendersky, on behalf of the Go team
6 February 2024

Today the Go team is thrilled to release Go 1.22, which you can get by visiting the [download page](https://go.dev/dl/).`;

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const large = machines.find((m) => m.id === 'large')!;
const inFlight = ratio(large, 'maxConcurrency')!.toFixed(1);
const perSecond = ratio(large, 'pagesPerSecond')!.toFixed(1);

const fmt = (n: number) => n.toLocaleString('en-US');
const trackerStart = rawHead.length;
const rawHtml = await highlight(rawHead + rawTracker + rawTail, 'html', [
  { start: trackerStart, end: trackerStart + rawTracker.length, properties: { class: 'tracker' } },
]);
const markdownHtml = await highlight(markdown, 'md');
const swapHtml = await highlight('- https://api.firecrawl.dev/v1/scrape\n+ http://localhost:8080/v1/scrape', 'diff');
---

<Layout
  title="Huntsman: the web, read for your AI agents"
  description="Open-source web fetch for Claude Code, Codex, Copilot, Cursor and any MCP agent: clean Markdown from any page, without ads, trackers or markup. Runs on your machine or your server."
>
  <main>
    <section class="hero" aria-labelledby="title">
      <div class="clouds" aria-hidden="true">
        <img class="cloud c1" src="/art/cloud-1.webp" alt="" width="241" height="130" />
        <img class="cloud c2" src="/art/cloud-2.webp" alt="" width="232" height="127" />
        <img class="cloud c3" src="/art/cloud-3.webp" alt="" width="104" height="56" />
        <img class="cloud c4" src="/art/cloud-2.webp" alt="" width="232" height="127" />
      </div>
      <div class="wrap hero-inner">
        <a class="oss-badge" href={repo}>
          <Logo name="GitHub" size={16} />
          <span>Open source · Apache-2.0</span>
          {latest && <span class="badge-part badge-version"><Icon name="tag" size={14} /> {latest}</span>}
          {stars && <span class="badge-part"><Icon name="star" size={14} /> {stars}</span>}
        </a>
        <h1 id="title">Give your agents the web, without the junk.</h1>
        <p class="sub">
          Huntsman is the web fetch tool for Claude Code, Codex, Copilot, Cursor and any MCP agent. It renders the
          page, blocks ads and trackers, and hands back just the content as Markdown.
        </p>

        <div class="paths">
          <div class="path-tabs" role="tablist" aria-label="Where to install" hidden>
            <button type="button" role="tab" id="tab-local" aria-controls="path-local" aria-selected="true">
              <Icon name="laptop" size={16} /> For local agents
            </button>
            <button type="button" role="tab" id="tab-remote" aria-controls="path-remote" aria-selected="false" tabindex="-1">
              <Icon name="server" size={16} /> For remote agents
            </button>
          </div>
          <div class="path" role="tabpanel" id="path-local" aria-labelledby="tab-local">
            <p class="path-label">Paste into your agent. It installs Huntsman and connects itself.</p>
            <CopyField text={agentPrompt} label="Copy prompt" />
            <p class="path-label">
              Or run it yourself on macOS or Linux. No sudo, starts at login. Windows:{' '}
              <a href="/install#windows">WSL or Docker</a>.
            </p>
            <CopyField text={install} label="Copy" prefix="$" />
          </div>
          <div class="path" role="tabpanel" id="path-remote" aria-labelledby="tab-remote">
            <p class="path-label">On your Linux server, install the same single binary.</p>
            <CopyField text={install} label="Copy" prefix="$" />
            <p class="path-label">Open it to other machines, with a token since it now listens beyond localhost.</p>
            <CopyField text={serverOpen} label="Copy" prefix="$" />
            <p class="path-label">
              Then point each agent at its <code>/mcp</code> with that token, behind your HTTPS proxy.{' '}
              <a href="/install#server">Server guide</a>.
            </p>
            <CopyField text={remoteClaude} label="Copy" prefix="$" />
          </div>
        </div>

        <div class="hero-agents">
          <span>Works with</span>
          <ul>
            {
              harnesses.map((h, i) => (
                <li style={`--brand: ${brand[h.name]}; --i: ${i}`}>
                  <a href={`/agents#${slug(h.name)}`} title={h.name}>
                    <Logo name={h.name} size={18} />
                    <span class="visually-hidden">{h.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <img class="hero-art" src="/art/hero.webp" alt="" width="1536" height="1024" fetchpriority="high" decoding="async" />
    </section>

    <section class="wrap scene-sec" id="why" aria-labelledby="why-title">
      <header class="center-head">
        <h2 id="why-title">Your agent pays for every token it reads.</h2>
        <p>One real page, go.dev/blog/go1.22, with tokens counted the way models count them.</p>
      </header>

      <div class="scene">
        <figure class="paper paper-raw">
          <p class="paper-count"><span class="n" data-count={htmlTokens}>{fmt(htmlTokens)}</span> tokens</p>
          <figcaption>The page as HTML: scripts, trackers, markup</figcaption>
          <div class="paper-code" aria-hidden="true" set:html={rawHtml} />
          <p class="visually-hidden">Raw HTML of the page: tracking scripts, metadata and markup.</p>
        </figure>

        <div class="machine">
          <img src="/art/markdown.webp" alt="" width="800" height="800" loading="lazy" decoding="async" />
          <p class="caught">
            <Icon name="ban" size={14} />
            <span>blocked <s>googletagmanager.com</s></span>
          </p>
          <p class="machine-note">
            A real browser loads the page. 150,000+ blocklist rules stop ads, trackers and cookie banners before they
            load.
          </p>
        </div>

        <figure class="paper paper-md">
          <p class="paper-count"><span class="n" data-count={mdTokens}>{fmt(mdTokens)}</span> tokens</p>
          <figcaption>What your agent reads, as Markdown</figcaption>
          <div class="paper-code" set:html={markdownHtml} />
        </figure>
      </div>

      <p class="scene-foot">
        <strong>{saved}% fewer tokens</strong> on this page. Single-page apps render, and PDFs are read directly.{' '}
        <a href="#try">Try any page <Icon name="arrow" size={16} /></a>
      </p>
    </section>

    <div class="wrap features">
      <section class="feature" data-tone="peach" id="agents" aria-labelledby="agents-title">
        <div class="feature-copy">
          <h2 id="agents-title">Connect it once. <span class="ink">Every agent gets the web.</span></h2>
          <p class="feature-text">
            Huntsman is an MCP server at <code>{mcpUrl}</code>. Pick your agent and run its one-time setup.
          </p>
          <fieldset class="picker">
            <legend class="visually-hidden">Agent</legend>
            {
              harnesses.map((h, i) => (
                <>
                  <input
                    class="tab-in visually-hidden"
                    type="radio"
                    name="harness"
                    id={`harness-${slug(h.name)}`}
                    checked={i === 0}
                  />
                  <label class="tab" for={`harness-${slug(h.name)}`} style={`--brand: ${brand[h.name]}`}>
                    <Logo name={h.name} />
                    {h.name}
                  </label>
                  <div class="panel">
                    <p class="how">{h.how}</p>
                    <CodeBlock wrap={!h.lang} code={h.code} lang={h.lang ?? 'bash'} label={h.lang ? 'Config' : 'Terminal'} />
                    <p class="more">
                      <a href={`/agents#${slug(h.name)}`}>
                        Full {h.name} setup <Icon name="arrow" size={16} />
                      </a>
                    </p>
                  </div>
                </>
              ))
            }
          </fieldset>
        </div>
        <div class="feature-art"><img src="/art/agents.webp" alt="" width="800" height="800" loading="lazy" decoding="async" /></div>

        <div class="tools">
          <h3 class="tools-title"><Icon name="plug" size={16} /> Tools your agent gets</h3>
          <ul>
            {
              tools.map(([name, what]) => (
                <li>
                  <code>{name}</code>
                  <span>{what}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>

    <section class="wrap try" id="try" aria-labelledby="try-title">
      <header class="center-head">
        <h2 id="try-title">See it for yourself</h2>
        <p>Paste any address and read exactly what your agent would get, with its token count.</p>
      </header>
      <div class="try-box"><LiveScrape /></div>
    </section>

    <div class="wrap features">
      <section class="feature" data-tone="pink" aria-labelledby="crawl-title">
        <div class="feature-copy">
          <h2 id="crawl-title">Whole sites, <span class="ink">not just pages.</span></h2>
          <p class="feature-text">Batch 1,000 URLs in one call, or crawl a site’s docs up to a page limit and depth.</p>
          <div class="card out">
            <p><span class="fn">batch_scrape</span> <span class="muted">100 urls</span></p>
            <div class="bar" aria-hidden="true"><span class="bar-ok"></span><span class="bar-fail"></span></div>
            <p>
              <span class="ok"><Icon name="check" size={14} /> 99 completed</span>{' · '}
              <span class="del">1 failed</span>{' · '}<span class="muted">1m 58s</span>
            </p>
          </div>
          <p class="more"><a href="#api">Crawl API <Icon name="arrow" size={16} /></a></p>
        </div>
        <div class="feature-art"><img src="/art/crawl.webp" alt="" width="800" height="800" loading="lazy" decoding="async" /></div>
      </section>

      <section class="feature" data-tone="lime" aria-labelledby="safe-title">
        <div class="feature-copy">
          <h2 id="safe-title">Stays off <span class="ink">your network.</span></h2>
          <p class="feature-text">Blocks internal addresses and respects <code>robots.txt</code>.</p>
          <div class="card">
            <dl class="out probe">
              <dt>url</dt>
              <dd>http://169.254.169.254/<wbr />latest/meta-data.pdf</dd>
              <dt><span class="status-bad">502</span></dt>
              <dd>dial tcp 169.254.169.254:80: blocked private network address</dd>
            </dl>
          </div>
          <p class="more"><a href="#config">Configuration <Icon name="arrow" size={16} /></a></p>
        </div>
        <div class="feature-art"><img src="/art/blocking.webp" alt="" width="800" height="800" loading="lazy" decoding="async" /></div>
      </section>
    </div>

    <section class="wrap bench" id="benchmarks" aria-labelledby="bench-title">
      <header class="center-head">
        <h2 id="bench-title">Benchmarks</h2>
        <p>
          Each engine self-hosted alone on the same ARM machine, scraping 1,000 live URLs at rising load. On{' '}
          {large.vcpu} vCPU Huntsman keeps {inFlight}× the pages in flight of Firecrawl, at {perSecond}× the pages per
          second. <a href={`${repo}/tree/main/benchmark`}>Run it yourself</a>.
        </p>
      </header>
      <div class="bench-card"><Benchmarks /></div>
    </section>

    <section class="wrap oss" id="open-source" aria-labelledby="oss-title">
      <div class="oss-head">
        <h2 id="oss-title">Open source, <span class="ink">top to bottom.</span></h2>
        <p>
          Apache-2.0 Go you can read, fork and run anywhere. No account, no API key, no per-page bill. Issues and pull
          requests welcome.
        </p>
      </div>

      <div class="oss-grid">
        <a class="repo" href={repo}>
          <span class="repo-name"><Logo name="GitHub" size={24} /><span>TulipFarm/<strong>huntsman</strong></span></span>
          <span class="repo-desc">Self-hosted web scraper with a Firecrawl-compatible API and an MCP server for AI agents.</span>
          <span class="repo-meta">
            <span><span class="go-dot" aria-hidden="true"></span>Go</span>
            <span><Icon name="scale" size={14} /> Apache-2.0</span>
            {stars && <span><Icon name="star" size={14} /> {stars} stars</span>}
            {latest && <span><Icon name="tag" size={14} /> {latest}</span>}
          </span>
        </a>

        <ul class="oss-links">
          {
            ossLinks.map(([icon, label, href]) => (
              <li>
                <a href={href}>
                  <Icon name={icon} size={18} />
                  <span>{label}</span>
                  <Icon name="arrow" size={16} class="go" />
                </a>
              </li>
            ))
          }
        </ul>

        <div class="built">
          <h3>Built on open source</h3>
          <dl>
            <dt><a href="https://lightpanda.io">Lightpanda</a></dt>
            <dd>The headless browser that renders each page. AGPL-3.0, run unmodified as a separate process.</dd>
            <dt><a href="https://easylist.to">EasyList</a>, EasyPrivacy and Fanboy’s Cookiemonster</dt>
            <dd>The filter lists that block ads, trackers and cookie banners.</dd>
          </dl>
        </div>

        <div class="swap">
          <h3><Icon name="swap" size={16} /> Already on Firecrawl?</h3>
          <p>Same <code>/v1</code> API. Change one base URL in your code.</p>
          <div class="out" set:html={swapHtml} />
        </div>
      </div>
      <img class="oss-art" src="/art/machine.webp" alt="" width="1536" height="1024" loading="lazy" decoding="async" />
    </section>

    <section class="wrap start" id="start" aria-labelledby="start-title">
      <header class="center-head">
        <h2 id="start-title">Install it where your agents run</h2>
        <p>On your laptop for the agents you use every day, or on a server for agents in CI and the cloud.</p>
      </header>
      <ol class="steps">
        <li>
          <p class="step-n"><Icon name="laptop" size={16} /> Local agents</p>
          <h3>On your machine</h3>
          <p>
            One command on macOS or Linux. It puts Huntsman, its browser and the filter lists in{' '}
            <code>~/.huntsman</code>, checks the download, and runs it at every login. Then add{' '}
            <code>{mcpUrl}</code> to your agent.
          </p>
          <CodeBlock wrap code={install} label="Terminal" />
          <CodeBlock wrap code={claude} label="Claude Code" />
          <p class="more"><a href="/install">Install guide <Icon name="arrow" size={16} /></a></p>
        </li>
        <li>
          <p class="step-n"><Icon name="server" size={16} /> Remote agents</p>
          <h3>On a server</h3>
          <p>
            Share one Huntsman between machines, or run big crawls. Install the same binary, then open it to other
            machines with a token.
          </p>
          <CodeBlock wrap code={`${install}\n${serverOpen}`} label="On the server" />
          <CodeBlock wrap code={remoteClaude} label="In your agent" />
          <p class="more"><a href="/install#server">Server guide <Icon name="arrow" size={16} /></a></p>
        </li>
        <li>
          <p class="step-n"><Icon name="code" size={16} /> Your code</p>
          <h3>From any language</h3>
          <p>Send a URL to <code>/v1/scrape</code> and get back the page’s main content as Markdown, plus its links.</p>
          <CodeBlock wrap code={scrape} label="Scrape example.com" />
          <details class="mini">
            <summary><Icon name="chevron" size={16} /> Example response</summary>
            <CodeBlock code={response} lang="json" label="Response, shortened" />
          </details>
        </li>
      </ol>
    </section>

    <section class="wrap reference" aria-labelledby="ref-title">
      <h2 id="ref-title">Reference</h2>
      <div class="ref-card">
        <details class="disclosure" id="api">
          <summary>
            <span class="sum-title">API</span>
            <span class="sum-desc">Firecrawl-compatible <code>/v1</code> endpoints, MCP and health</span>
            <Icon name="chevron" class="sum-icon" />
          </summary>
          <div class="disclosure-body">
            <p class="lede">
              Requests and responses follow Firecrawl’s <code>/v1</code> shapes, so most clients only need a new base
              URL. Unknown fields are rejected, so typos fail loudly.
            </p>
            <div class="ref-grid">
              <div>
                <table class="ref">
                  <caption class="visually-hidden">Endpoints</caption>
                  <thead>
                    <tr><th scope="col">Endpoint</th><th scope="col">What it does</th></tr>
                  </thead>
                  <tbody>
                    {
                      endpoints.map(([method, path, what]) => (
                        <tr>
                          <th scope="row">
                            <span class:list={['method', method.toLowerCase()]}>{method}</span> <code>{path}</code>
                          </th>
                          <td>{what}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
                <p class="aside">
                  <strong>Coming from Firecrawl?</strong> Keep calling <code>/v1/scrape</code>. Huntsman deliberately
                  does less: it returns Markdown and links only, with no screenshots, HTML, JSON extraction, actions or
                  search.
                </p>
              </div>
              <div>
                <h3 class="ref-title">Crawl a site</h3>
                <CodeBlock wrap code={crawl} label="Start a crawl and read its pages" />
              </div>
            </div>
          </div>
        </details>

        <details class="disclosure" id="config">
          <summary>
            <span class="sum-title">Configuration</span>
            <span class="sum-desc">Environment variables and their defaults</span>
            <Icon name="chevron" class="sum-icon" />
          </summary>
          <div class="disclosure-body">
            <p class="lede">
              Everything is an environment variable. With the install script, set them in <code>~/.huntsman/env</code>
              and run <code>huntsman restart</code>. The <a href="/install#configuration">install guide</a> has the full
              list.
            </p>
            <table class="ref">
              <caption class="visually-hidden">Common settings</caption>
              <thead>
                <tr><th scope="col">Variable</th><th scope="col">Default</th><th scope="col">Meaning</th></tr>
              </thead>
              <tbody>
                {
                  settings.map(([name, def, what]) => (
                    <tr>
                      <th scope="row"><code>{name}</code></th>
                      <td><code>{def}</code></td>
                      <td>{what}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </details>
      </div>
    </section>

    <section class="wrap closing" aria-labelledby="closing-title">
      <h2 id="closing-title">Give your agents the web.</h2>
      <p>Paste this into your agent. It installs Huntsman and connects itself.</p>
      <div class="closing-field"><CopyField text={agentPrompt} label="Copy prompt" /></div>
      <div class="closing-actions">
        <a class="button primary" href="/install">Install guide <Icon name="arrow" size={16} /></a>
        <a class="button secondary" href={repo}>
          <Logo name="GitHub" size={16} /> Star on GitHub{stars && <span class="count-pill">{stars}</span>}
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Opening #api or #config from the nav or a link expands that reference section.
  const openFromHash = () => {
    const el = document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  // Install tabs. Without JavaScript both paths show, one after the other.
  const tablist = document.querySelector<HTMLElement>('.path-tabs');
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
    };
    tablist.hidden = false;
    select(tabs[0]);
    tablist.addEventListener('click', (e) => {
      const tab = (e.target as Element).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab);
    });
    tablist.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
