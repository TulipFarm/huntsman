---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import Benchmarks from '../components/Benchmarks.astro';
import CodeBlock from '../components/CodeBlock.astro';
import LiveScrape from '../components/LiveScrape.astro';
import { machines } from '../data/benchmarks';

const repo = 'https://github.com/TulipFarm/huntsman';
const image = 'ghcr.io/tulipfarm/huntsman';

const run = `docker run -d --name huntsman -p 127.0.0.1:8080:8080 \\
  -v huntsman-data:/data ${image}:latest`;

const scrape = `curl -s localhost:8080/v1/scrape \\
  -H 'Content-Type: application/json' \\
  -d '{"url": "https://example.com"}'`;

const response = `{
  "success": true,
  "data": {
    "markdown": "This domain is for use in documentation examples …",
    "links": ["https://iana.org/help/example-domains"],
    "metadata": {
      "title": "Example Domain",
      "statusCode": 200,
      "engine": "lightpanda"
    }
  }
}`;

const sized = `docker run -d --name huntsman -p 127.0.0.1:8080:8080 \\
  -v huntsman-data:/data \\
  -e HUNTSMAN_WORKERS=64 \\
  ${image}:latest`;

const production = `docker run -d --name huntsman -p 8080:8080 \\
  -v huntsman-data:/data \\
  -e HUNTSMAN_TOKEN="$(openssl rand -hex 32)" \\
  ${image}:0.1.0`;

const authed = `curl -s https://scraper.example.com/v1/scrape \\
  -H "Authorization: Bearer $HUNTSMAN_TOKEN" \\
  -H 'Content-Type: application/json' \\
  -d '{"url": "https://example.com", "onlyMainContent": true}'`;

const crawl = `curl -s localhost:8080/v1/crawl \\
  -H 'Content-Type: application/json' \\
  -d '{"url": "https://example.com", "limit": 50, "maxDepth": 2}'
# → {"success": true, "id": "…"}

curl -s 'localhost:8080/v1/crawl/<id>?offset=0'`;

const endpoints = [
  ['POST', '/v1/scrape', 'Scrape one URL and return Markdown and links'],
  ['POST', '/v1/batch', 'Queue 1–1,000 URLs with shared scrape options'],
  ['GET', '/v1/jobs/{id}', 'Status and result of a queued job'],
  ['POST', '/v1/crawl', 'Crawl a site up to a page limit and depth'],
  ['GET', '/v1/crawl/{id}', 'Crawl progress and pages, paged with ?offset='],
  ['GET', '/health', 'Liveness and storage check'],
];

const settings = [
  ['HUNTSMAN_WORKERS', '4', 'Pages scraped at once. The default is safe for any machine; raise it to use yours fully (see step 3 above).'],
  ['HUNTSMAN_PER_HOST', '2', 'Most pages scraped at once from a single site, so one site isn’t flooded. Max 64.'],
  ['HUNTSMAN_TOKEN', 'empty', 'Bearer token; empty turns auth off'],
  ['HUNTSMAN_TOKENS', 'empty', 'Named keys, name:token,... One per client, so you can revoke one without the others'],
  ['HUNTSMAN_CACHE_TTL', '1h', 'Default result cache age, up to 168h'],
  ['HUNTSMAN_OBEY_ROBOTS', 'true', 'Respect robots.txt'],
  ['HUNTSMAN_QUEUE_CAPACITY', '10000', 'Queued jobs before 429'],
];

const huntsman = machines.map((m) => ({
  m,
  r: m.results.find((r) => r.engine === 'Huntsman')!,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Huntsman: turn any web page into clean Markdown</title>
    <meta
      name="description"
      content="A self-hosted, Firecrawl-compatible web scraper in one Go binary. On the same machine it keeps 3–5.6× as many pages in flight as Firecrawl."
    />
    <meta name="theme-color" content="#101113" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7f4" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="wrap site-header">
      <a class="brand" href="/" aria-label="Huntsman home">
        <svg class="mark" aria-hidden="true" viewBox="0 0 32 32" width="28" height="28">
          <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 13 8 7 3 8M12.5 15.5 6 13l-4 3M13 18l-6 3-3 5M14.5 19.5 12 26l2 4"></path>
            <path d="M19 13l5-6 5 1M19.5 15.5 26 13l4 3M19 18l6 3 3 5M17.5 19.5 20 26l-2 4"></path>
          </g>
          <ellipse cx="16" cy="13.5" rx="3.4" ry="3" fill="currentColor"></ellipse>
          <ellipse cx="16" cy="20" rx="2.6" ry="3.6" fill="currentColor"></ellipse>
        </svg>
        <span>Huntsman</span>
      </a>
      <a class="maker" href="https://tulipfarm.ai">by TulipFarm.ai</a>
      <nav aria-label="Main">
        <a href="#benchmarks">Benchmarks</a>
        <a href="#start">Get started</a>
        <a href="#api">API</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="wrap hero" aria-labelledby="title">
        <h1 id="title">Turn any web page into clean <em>Markdown</em>.</h1>
        <div class="hero-side">
          <p class="sub">
            A self-hosted scraper with a Firecrawl-compatible API, in one Go binary and one container. It renders
            JavaScript with Lightpanda and strips ads, trackers and cookie banners. No Redis, no Playwright, no
            Chrome.
          </p>
          <div class="actions">
            <a class="button primary" href="#start">Get started</a>
            <a class="button secondary" href={repo}>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
              GitHub
            </a>
          </div>
        </div>
      </section>

      <div class="stage">
        <div class="wrap stage-grid">
          <div class="col"><Benchmarks /></div>
          <div class="col"><LiveScrape /></div>
        </div>
      </div>

      <section class="wrap start" id="start" aria-labelledby="start-title">
        <div class="section-head">
          <h2 id="start-title">Get started</h2>
          <p>From an empty machine to your first page of Markdown in about a minute.</p>
        </div>

        <ol class="steps">
          <li>
            <div class="step-text">
              <h3>Run the container</h3>
              <p>
                The image is published for <code>linux/amd64</code> and <code>linux/arm64</code>. The volume keeps the
                job queue and result cache across restarts.
              </p>
            </div>
            <CodeBlock code={run} label="Run Huntsman with Docker" />
          </li>

          <li>
            <div class="step-text">
              <h3>Scrape a page</h3>
              <p>Send a URL to <code>/v1/scrape</code> and get back the page’s main content as Markdown, plus its links.</p>
            </div>
            <div class="stack">
              <CodeBlock code={scrape} label="Scrape example.com" />
              <CodeBlock code={response} lang="json" label="Example response, shortened" />
            </div>
          </li>

          <li>
            <div class="step-text">
              <h3>Size it for your machine</h3>
              <p>
                <code>HUNTSMAN_WORKERS</code> sets how many pages are scraped at once. It defaults to 4 so Huntsman runs
                safely anywhere; these are the highest values that held up in the benchmark above. Memory grows over runs of many hours, so leave headroom for
                long-running servers.
              </p>
              <table class="sizes">
                <caption class="visually-hidden">Highest tested HUNTSMAN_WORKERS per machine size</caption>
                <thead>
                  <tr><th scope="col">Machine</th><th scope="col" class="num">Tested max</th></tr>
                </thead>
                <tbody>
                  {
                    huntsman.map(({ m, r }) => (
                      <tr>
                        <th scope="row">
                          {m.label} <span class="spec">{m.vcpu} vCPU · {m.memoryGB} GB</span>
                        </th>
                        <td class="num">{r.maxConcurrency}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <CodeBlock code={sized} label="Run Huntsman with 64 workers" />
          </li>

          <li>
            <div class="step-text">
              <h3>Lock it down for production</h3>
              <p>
                Pin a version and set <code>HUNTSMAN_TOKEN</code>. Every endpoint except <code>/health</code> then
                needs the token as a bearer header. Private, loopback and link-local addresses are blocked by default.
              </p>
            </div>
            <div class="stack">
              <CodeBlock code={production} label="Run a pinned version with a token" />
              <CodeBlock code={authed} label="Scrape with the token" />
            </div>
          </li>
        </ol>
      </section>

      <section class="wrap reference" id="api" aria-labelledby="api-title">
        <div class="section-head">
          <h2 id="api-title">API</h2>
          <p>
            Requests and responses follow Firecrawl’s <code>/v1</code> shapes, so most clients only need a new base
            URL. Unknown fields are rejected, so typos fail loudly.
          </p>
        </div>

        <div class="ref-grid">
          <div>
            <table class="ref">
              <caption class="visually-hidden">Endpoints</caption>
              <thead>
                <tr><th scope="col">Endpoint</th><th scope="col">What it does</th></tr>
              </thead>
              <tbody>
                {
                  endpoints.map(([method, path, what]) => (
                    <tr>
                      <th scope="row">
                        <span class="method">{method}</span> <code>{path}</code>
                      </th>
                      <td>{what}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="aside">
              <strong>Coming from Firecrawl?</strong> Keep calling <code>/v1/scrape</code>. Huntsman deliberately does
              less: it returns Markdown and links only, with no screenshots, HTML, JSON extraction, actions or search.
            </p>
          </div>
          <div>
            <h3 class="ref-title">Crawl a site</h3>
            <CodeBlock code={crawl} label="Start a crawl and read its pages" />
          </div>
        </div>
      </section>

      <section class="wrap reference" id="config" aria-labelledby="config-title">
        <div class="section-head">
          <h2 id="config-title">Configuration</h2>
          <p>
            Everything is an environment variable. The most used ones are below; the{' '}
            <a href={`${repo}#configuration`}>full list is in the README</a>.
          </p>
        </div>
        <table class="ref">
          <caption class="visually-hidden">Common settings</caption>
          <thead>
            <tr><th scope="col">Variable</th><th scope="col">Default</th><th scope="col">Meaning</th></tr>
          </thead>
          <tbody>
            {
              settings.map(([name, def, what]) => (
                <tr>
                  <th scope="row"><code>{name}</code></th>
                  <td><code>{def}</code></td>
                  <td>{what}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
    </main>

    <footer class="wrap site-footer">
      <p>
        Apache-2.0. The Docker image also ships Lightpanda (AGPL-3.0, run unmodified as a separate process) and the
        EasyList filter lists. <a href={`${repo}/blob/main/NOTICE`}>Notices</a>
      </p>
      <p>Built by <a href="https://tulipfarm.ai">TulipFarm</a>.</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .mark {
    color: var(--accent);
  }

  .maker {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    margin-left: calc(-1 * var(--space-3));
    margin-right: auto;
    color: var(--text-muted);
    font-size: 0.875rem;
    white-space: nowrap;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .maker:hover {
      color: var(--text);
    }
  }

  nav {
    display: flex;
    gap: var(--space-1);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--text);
      background: var(--surface-2);
    }
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: end;
    padding-block: var(--space-12) var(--space-12);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 1.4rem + 4.4vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  h1 em {
    color: var(--accent);
  }

  .sub {
    max-width: 46ch;
    color: var(--text-muted);
  }

  .stage {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }

  .col {
    display: flex;
    min-width: 0;
  }

  .col > :global(*) {
    flex: 1;
  }

  .stage-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .stage-grid > .col:first-child {
    padding: var(--space-8) var(--space-12) var(--space-8) 0;
    border-right: 1px solid var(--border);
  }

  .stage-grid > .col:last-child {
    padding: var(--space-8) 0 var(--space-8) var(--space-12);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-h);
    padding-inline: var(--space-6);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .button:active {
    transform: scale(0.97);
  }

  .primary {
    background: var(--accent);
    color: var(--on-accent);
  }

  .secondary {
    border: 1px solid var(--border-strong);
    color: var(--text);
  }

  @media (hover: hover) and (pointer: fine) {
    .primary:hover {
      background: var(--accent-hover);
      text-decoration: none;
    }

    .secondary:hover {
      background: var(--surface-2);
      text-decoration: none;
    }
  }

  .primary:active {
    background: var(--accent-press);
  }

  .section-head {
    margin-bottom: var(--space-8);
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 1.5rem + 1.8vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .section-head p {
    max-width: 62ch;
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  .start {
    padding-top: var(--space-24);
  }

  .steps {
    display: grid;
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps > li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    counter-increment: step;
  }

  .step-text {
    position: relative;
    padding-left: var(--space-16);
  }

  .step-text h3 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .step-text::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.2em;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 3.25rem;
    line-height: 1;
  }

  .step-text p {
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  .stack {
    display: grid;
    gap: var(--space-3);
  }

  .sizes,
  .ref {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .sizes {
    margin-top: var(--space-4);
  }

  .sizes th,
  .sizes td,
  .ref th,
  .ref td {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: baseline;
  }

  .ref th,
  .ref td {
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
  }

  .sizes thead th,
  .ref thead th {
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .sizes tbody th,
  .ref tbody th {
    font-weight: 500;
  }

  .sizes .num {
    text-align: right;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }

  .spec {
    margin-left: var(--space-2);
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .reference {
    padding-top: var(--space-24);
  }

  .ref-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: start;
  }

  .ref tbody th {
    white-space: nowrap;
  }

  .method {
    display: inline-block;
    min-width: 4ch;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .ref-title {
    margin-bottom: var(--space-3);
    font-size: 1rem;
    font-weight: 600;
  }

  .aside {
    margin-top: var(--space-6);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    max-width: 70ch;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-24);
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .site-footer p:first-child {
    max-width: 70ch;
  }

  @media (max-width: 960px) {
    .hero,
    .stage-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero {
      gap: var(--space-6);
    }

    .stage-grid > .col:first-child,
    .stage-grid > .col:last-child {
      padding: var(--space-8) 0;
      border-right: 0;
    }

    .stage-grid > .col:first-child {
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 860px) {
    .steps > li,
    .ref-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .ref-grid {
      gap: var(--space-12);
    }
  }

  @media (max-width: 640px) {
    nav a:not(:last-child):not([href='#start']) {
      display: none;
    }
  }

  /* The hero repeats Get started and GitHub right below, so phones keep just the brand line. */
  @media (max-width: 480px) {
    nav {
      display: none;
    }
  }

  @media (max-width: 640px) {

    .hero {
      padding-block: var(--space-8);
    }

    .step-text {
      padding-left: var(--space-12);
    }

    .step-text::before {
      font-size: 2.5rem;
    }

    .actions .button {
      flex: 1;
      justify-content: center;
    }

    .ref th,
    .ref td {
      display: block;
      padding: 0;
      border: 0;
    }

    .ref thead {
      display: none;
    }

    .ref tr {
      display: grid;
      gap: var(--space-1);
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--border);
    }

    .ref tbody th {
      white-space: normal;
    }
  }
</style>
