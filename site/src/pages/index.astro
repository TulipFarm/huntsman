---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import Benchmarks from '../components/Benchmarks.astro';
import CodeBlock from '../components/CodeBlock.astro';
import LiveScrape from '../components/LiveScrape.astro';
import { machines, ratio } from '../data/benchmarks';

const repo = 'https://github.com/TulipFarm/huntsman';
const dataset = 'https://huggingface.co/datasets/tulipfarmai/huntsman-scrape-dataset-v1';
const image = 'ghcr.io/tulipfarm/huntsman';

const run = `docker run -d --name huntsman -p 127.0.0.1:8080:8080 \\
  -v huntsman-data:/data ${image}:latest`;

const scrape = `curl -s localhost:8080/v1/scrape \\
  -H 'Content-Type: application/json' \\
  -d '{"url": "https://example.com"}'`;

const response = `{
  "success": true,
  "data": {
    "markdown": "This domain is for use in documentation examples …",
    "links": ["https://iana.org/help/example-domains"],
    "metadata": {
      "title": "Example Domain",
      "statusCode": 200,
      "engine": "lightpanda"
    }
  }
}`;

const sized = `docker run -d --name huntsman -p 127.0.0.1:8080:8080 \\
  -v huntsman-data:/data \\
  -e HUNTSMAN_WORKERS=64 \\
  ${image}:latest`;

const production = `docker run -d --name huntsman -p 8080:8080 \\
  -v huntsman-data:/data \\
  -e HUNTSMAN_TOKEN="$(openssl rand -hex 32)" \\
  ${image}:0.1.0`;

const authed = `curl -s https://scraper.example.com/v1/scrape \\
  -H "Authorization: Bearer $HUNTSMAN_TOKEN" \\
  -H 'Content-Type: application/json' \\
  -d '{"url": "https://example.com", "onlyMainContent": true}'`;

const crawl = `curl -s localhost:8080/v1/crawl \\
  -H 'Content-Type: application/json' \\
  -d '{"url": "https://example.com", "limit": 50, "maxDepth": 2}'
# → {"success": true, "id": "…"}

curl -s 'localhost:8080/v1/crawl/<id>?offset=0'`;

const endpoints = [
  ['POST', '/v1/scrape', 'Scrape one URL and return Markdown and links'],
  ['POST', '/v1/batch', 'Queue 1–1,000 URLs with shared scrape options'],
  ['GET', '/v1/jobs/{id}', 'Status and result of a queued job'],
  ['POST', '/v1/crawl', 'Crawl a site up to a page limit and depth'],
  ['GET', '/v1/crawl/{id}', 'Crawl progress and pages, paged with ?offset='],
  ['GET', '/health', 'Liveness and storage check'],
];

const settings = [
  ['HUNTSMAN_WORKERS', '16 per CPU', 'Pages scraped at once, capped at one per 96 MB of memory. Container limits count (see step 3 above).'],
  ['HUNTSMAN_PER_HOST', '2', 'Most pages scraped at once from a single site, so one site isn’t flooded. Max 64.'],
  ['HUNTSMAN_TOKEN', 'empty', 'Bearer token; empty turns auth off'],
  ['HUNTSMAN_TOKENS', 'empty', 'Named keys, name:token,... One per client, so you can revoke one without the others'],
  ['HUNTSMAN_CACHE_TTL', '1h', 'Default result cache age, up to 168h'],
  ['HUNTSMAN_OBEY_ROBOTS', 'true', 'Respect robots.txt'],
  ['HUNTSMAN_QUEUE_CAPACITY', '10000', 'Queued jobs before 429'],
];

// Real output for go.dev/blog/go1.22 (tokens counted with cl100k). The tracker URL is
// split out so it can be struck through where the blocklist catches it.
const rawHead = `<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'`;
const rawTracker = 'https://www.googletagmanager.com/gtm.js';
const rawTail = `?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-W8MVQXG');</script>
<script src="/js/site.js"></script>
<meta name="og:url" content="https://go.dev/blog/go1.22">
<meta name="og:title" content="Go 1.22 is released! - The Go Programming Language">
<title>Go 1.22 is released! - The Go Programming Language</title>`;
const markdown = `# Go 1.22 is released!

Eli Bendersky, on behalf of the Go team
6 February 2024

Today the Go team is thrilled to release Go 1.22, which you can
get by visiting the [download page](https://go.dev/dl/).`;

const links = [
  ['Benchmarks', '#benchmarks'],
  ['Why Huntsman', '#why'],
  ['Docs', '#api'],
  ['Dataset', dataset],
  ['GitHub', repo],
];

const large = machines.find((m) => m.id === 'large')!;
const inFlight = ratio(large, 'maxConcurrency')!.toFixed(1);
const perSecond = ratio(large, 'pagesPerSecond')!.toFixed(1);

const huntsman = machines.map((m) => ({
  m,
  r: m.results.find((r) => r.engine === 'Huntsman')!,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Huntsman: turn any web page into clean Markdown</title>
    <meta
      name="description"
      content="A self-hosted, Firecrawl-compatible web scraper in one Go binary. On the same machine it keeps 3–5.6× as many pages in flight as Firecrawl."
    />
    <meta name="theme-color" content="#101113" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7f4" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="wrap site-header">
      <a class="brand" href="/" aria-label="Huntsman home">
        <svg class="mark" aria-hidden="true" viewBox="0 0 32 32" width="28" height="28">
          <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 13 8 7 3 8M12.5 15.5 6 13l-4 3M13 18l-6 3-3 5M14.5 19.5 12 26l2 4"></path>
            <path d="M19 13l5-6 5 1M19.5 15.5 26 13l4 3M19 18l6 3 3 5M17.5 19.5 20 26l-2 4"></path>
          </g>
          <ellipse cx="16" cy="13.5" rx="3.4" ry="3" fill="currentColor"></ellipse>
          <ellipse cx="16" cy="20" rx="2.6" ry="3.6" fill="currentColor"></ellipse>
        </svg>
        <span>Huntsman</span>
      </a>
      <a class="maker" href="https://tulipfarm.ai">by TulipFarm.ai</a>
      <nav aria-label="Main">
        <ul class="links">
          {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
        <a class="button primary small" href="#start">Get started</a>
        <details class="menu">
          <summary aria-label="Menu">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </summary>
          <ul>
            {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </details>
      </nav>
    </header>

    <main>
      <section class="wrap hero" aria-labelledby="title">
        <h1 id="title">Turn any web page into clean <em>Markdown</em>.</h1>
        <p class="sub">
          A self-hosted scraper with a Firecrawl-compatible API, in one Go binary and one container. It renders
          JavaScript with Lightpanda and strips ads, trackers and cookie banners. No Redis, no Playwright, no Chrome.
        </p>
        <div class="try"><LiveScrape /></div>
        <p class="proof">
          <span><strong>{inFlight}×</strong> the pages in flight of Firecrawl</span>
          <span><strong>{perSecond}×</strong> the pages per second</span>
          <a href="#benchmarks">Same {large.vcpu} vCPU machine; see the benchmarks</a>
        </p>
      </section>

      <section class="wrap bench" id="benchmarks" aria-labelledby="bench-title">
        <div class="section-head">
          <h2 id="bench-title">Benchmarks</h2>
          <p>Each engine self-hosted alone on the same ARM machine, scraping 1,000 live URLs at rising load.</p>
        </div>
        <div class="bench-card"><Benchmarks /></div>
      </section>

      <section class="wrap why" id="why" aria-labelledby="why-title">
        <div class="section-head">
          <h2 id="why-title">Why Huntsman</h2>
          <p>Everything an agent or search pipeline needs from a page, and nothing it doesn’t.</p>
        </div>
        <div class="flow">
          <div class="flow-step">
            <p class="flow-label">The page</p>
            <figure class="artifact">
              <figcaption>HTML · 7,764 tokens</figcaption>
              <pre class="raw" aria-hidden="true">{rawHead}<s class="tracker">{rawTracker}</s>{rawTail}</pre>
            </figure>
          </div>
          <div class="flow-step blocked">
            <p class="flow-label">In the browser</p>
            <h3>No ads, trackers or cookie banners</h3>
            <p>150,000+ blocklist rules stop them before they load.</p>
            <dl class="out rule">
              <dt>blocked</dt>
              <dd>www.googletagmanager.com/gtm.js</dd>
              <dt>rule</dt>
              <dd class="add">||googletagmanager.com^</dd>
              <dt>list</dt>
              <dd>easyprivacy.txt:3716</dd>
            </dl>
          </div>
          <div class="flow-step">
            <p class="flow-label">You get</p>
            <h3>Just the content</h3>
            <p>Navigation, footers and boilerplate are stripped out.</p>
            <figure class="artifact">
              <figcaption>Markdown · 1,043 tokens</figcaption>
              <pre>{markdown}</pre>
            </figure>
          </div>
        </div>

        <ul class="ops">
          <li>
            <div>
              <h3>Swap in for Firecrawl</h3>
              <p>Same <code>/v1</code> API. Change one base URL.</p>
            </div>
            <pre class="out"><span class="del">- https://api.firecrawl.dev/v1/scrape</span>{'\n'}<span class="add">+ http://localhost:8080/v1/scrape</span></pre>
          </li>
          <li>
            <div>
              <h3>JavaScript sites and PDFs</h3>
              <p>Single-page apps render. PDFs are read directly.</p>
            </div>
            <table class="out">
              <thead>
                <tr><th scope="col">url</th><th scope="col">engine</th><th scope="col">time</th></tr>
              </thead>
              <tbody>
                <tr><td>react.dev/learn</td><td>lightpanda</td><td>2.4s</td></tr>
                <tr><td>arxiv.org/pdf/<wbr />1706.03762v7</td><td>pdf</td><td>0.95s</td></tr>
              </tbody>
            </table>
          </li>
          <li>
            <div>
              <h3>1,000 URLs in one call</h3>
              <p>Batch a list, or crawl a whole site.</p>
            </div>
            <div class="out">
              <p><span class="muted">POST /v1/batch</span> 100 urls</p>
              <div class="bar" aria-hidden="true"><span></span></div>
              <p><span class="add">99 completed</span> · <span class="del">1 failed</span> · 1m 58s</p>
            </div>
          </li>
          <li>
            <div>
              <h3>Safe to self-host</h3>
              <p>Blocks internal addresses and respects <code>robots.txt</code>.</p>
            </div>
            <dl class="out rule">
              <dt>url</dt>
              <dd>http://169.254.169.254/latest/meta-data.pdf</dd>
              <dt class="del">502</dt>
              <dd>dial tcp 169.254.169.254:80: blocked private network address</dd>
            </dl>
          </li>
        </ul>
      </section>

      <section class="wrap start" id="start" aria-labelledby="start-title">
        <div class="section-head">
          <h2 id="start-title">Get started</h2>
          <p>From an empty machine to your first page of Markdown in about a minute.</p>
        </div>

        <ol class="steps">
          <li>
            <div class="step-text">
              <h3>Run the container</h3>
              <p>
                The image is published for <code>linux/amd64</code> and <code>linux/arm64</code>. The volume keeps the
                job queue and result cache across restarts.
              </p>
            </div>
            <CodeBlock code={run} label="Run Huntsman with Docker" />
          </li>

          <li>
            <div class="step-text">
              <h3>Scrape a page</h3>
              <p>Send a URL to <code>/v1/scrape</code> and get back the page’s main content as Markdown, plus its links.</p>
            </div>
            <div class="stack">
              <CodeBlock code={scrape} label="Scrape example.com" />
              <CodeBlock code={response} lang="json" label="Example response, shortened" />
            </div>
          </li>

          <li>
            <div class="step-text">
              <h3>Size it for your machine</h3>
              <p>
                <code>HUNTSMAN_WORKERS</code> sets how many pages are scraped at once. By default Huntsman sizes it
                to the machine: 16 per CPU core, capped at one per 96 MB of memory, so 2 vCPU and 4 GB gets 32. Set it
                yourself to go further; these are the highest values that held up in the benchmark above. Memory grows over runs of many hours, so leave headroom for
                long-running servers.
              </p>
              <table class="sizes">
                <caption class="visually-hidden">Highest tested HUNTSMAN_WORKERS per machine size</caption>
                <thead>
                  <tr><th scope="col">Machine</th><th scope="col" class="num">Tested max</th></tr>
                </thead>
                <tbody>
                  {
                    huntsman.map(({ m, r }) => (
                      <tr>
                        <th scope="row">
                          {m.label} <span class="spec">{m.vcpu} vCPU · {m.memoryGB} GB</span>
                        </th>
                        <td class="num">{r.maxConcurrency}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <CodeBlock code={sized} label="Run Huntsman with 64 workers" />
          </li>

          <li>
            <div class="step-text">
              <h3>Lock it down for production</h3>
              <p>
                Pin a version and set <code>HUNTSMAN_TOKEN</code>. Every endpoint except <code>/health</code> then
                needs the token as a bearer header. Private, loopback and link-local addresses are blocked by default.
              </p>
            </div>
            <div class="stack">
              <CodeBlock code={production} label="Run a pinned version with a token" />
              <CodeBlock code={authed} label="Scrape with the token" />
            </div>
          </li>
        </ol>
      </section>

      <section class="wrap reference" aria-labelledby="ref-title">
        <h2 id="ref-title" class="ref-head">Reference</h2>
        <div class="section-head sub-head" id="api">
          <h3 id="api-title">API</h3>
          <p>
            Requests and responses follow Firecrawl’s <code>/v1</code> shapes, so most clients only need a new base
            URL. Unknown fields are rejected, so typos fail loudly.
          </p>
        </div>

        <div class="ref-grid">
          <div>
            <table class="ref">
              <caption class="visually-hidden">Endpoints</caption>
              <thead>
                <tr><th scope="col">Endpoint</th><th scope="col">What it does</th></tr>
              </thead>
              <tbody>
                {
                  endpoints.map(([method, path, what]) => (
                    <tr>
                      <th scope="row">
                        <span class="method">{method}</span> <code>{path}</code>
                      </th>
                      <td>{what}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="aside">
              <strong>Coming from Firecrawl?</strong> Keep calling <code>/v1/scrape</code>. Huntsman deliberately does
              less: it returns Markdown and links only, with no screenshots, HTML, JSON extraction, actions or search.
            </p>
          </div>
          <div>
            <h4 class="ref-title">Crawl a site</h4>
            <CodeBlock code={crawl} label="Start a crawl and read its pages" />
          </div>
        </div>

        <div class="section-head sub-head" id="config">
          <h3 id="config-title">Configuration</h3>
          <p>
            Everything is an environment variable. The most used ones are below; the{' '}
            <a href={`${repo}#configuration`}>full list is in the README</a>.
          </p>
        </div>
        <table class="ref">
          <caption class="visually-hidden">Common settings</caption>
          <thead>
            <tr><th scope="col">Variable</th><th scope="col">Default</th><th scope="col">Meaning</th></tr>
          </thead>
          <tbody>
            {
              settings.map(([name, def, what]) => (
                <tr>
                  <th scope="row"><code>{name}</code></th>
                  <td><code>{def}</code></td>
                  <td>{what}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section class="wrap closing" aria-labelledby="closing-title">
        <div>
          <h2 id="closing-title">Run it on your own machine.</h2>
          <p>One Go binary and one container. No Redis, no Playwright, no Chrome.</p>
          <div class="actions">
            <a class="button primary" href="#start">Get started</a>
            <a class="button secondary" href={repo}>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
              GitHub
            </a>
          </div>
        </div>
        <CodeBlock code={run} label="Run Huntsman with Docker" />
      </section>
    </main>

    <footer class="wrap site-footer">
      <p>
        Apache-2.0. The Docker image also ships Lightpanda (AGPL-3.0, run unmodified as a separate process) and the
        EasyList filter lists. <a href={`${repo}/blob/main/NOTICE`}>Notices</a>
      </p>
      <p>Built by <a href="https://tulipfarm.ai">TulipFarm</a>.</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .mark {
    color: var(--accent);
  }

  .maker {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    margin-left: calc(-1 * var(--space-3));
    margin-right: auto;
    color: var(--text-muted);
    font-size: 0.875rem;
    white-space: nowrap;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .maker:hover {
      color: var(--text);
    }
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .links,
  .menu ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a:not(.button) {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:not(.button):hover {
      color: var(--text);
      background: var(--surface-2);
    }
  }

  .button.small {
    height: 40px;
    margin-left: var(--space-2);
    padding-inline: var(--space-4);
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: var(--control-h);
    height: var(--control-h);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu[open] summary {
    background: var(--surface-2);
  }

  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    z-index: 10;
    flex-direction: column;
    min-width: 12rem;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.25);
    transform-origin: top right;
    animation: menu-in var(--dur-fast) var(--ease-out);
  }

  .menu ul a:not(.button) {
    display: flex;
    color: var(--text);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .hero {
    padding-block: var(--space-16) var(--space-12);
    text-align: center;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 1.2rem + 4.6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  h1 em {
    color: var(--accent);
  }

  .sub {
    max-width: 60ch;
    margin: var(--space-6) auto 0;
    color: var(--text-muted);
    font-size: 1.0625rem;
  }

  .try {
    display: flex;
    margin-top: var(--space-12);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 32px 64px -40px rgb(0 0 0 / 0.3);
    text-align: left;
  }

  .try > :global(*) {
    flex: 1;
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-8);
    margin-top: var(--space-8);
    font-size: 0.9375rem;
  }

  .proof strong {
    color: var(--accent);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .proof a {
    color: var(--text-muted);
  }

  .bench-card {
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
